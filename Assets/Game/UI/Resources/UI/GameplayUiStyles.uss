:root {
    --folio-deep-plum: #241B2B;
    --folio-charcoal-plum: #302936;
    --folio-raised-panel: #403746;
    --folio-parchment: #E8D8B8;
    --folio-muted-parchment: #BFAF95;
    --folio-leather-rust: #A65F43;
    --folio-gold: #D5A84A;
    --folio-moss: #73884E;
    --folio-azure: #4E91BD;
    --folio-coral: #D65B50;
    --folio-violet: #8A68A2;
}

.gameplay-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(240, 242, 247);
    -unity-font-definition: url("../../Fonts/PTSans-Regular.ttf");
}

.hud-row {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    height: 42px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    padding-right: 10px;
    background-color: rgba(18, 22, 30, 0.9);
    border-radius: 6px;
}

.hud-bar {
    width: 230px;
    height: 24px;
    margin-right: 14px;
}

.hud-bar .unity-progress-bar__background {
    background-color: rgb(45, 51, 64);
}

.hud-bar .unity-progress-bar__progress {
    background-color: rgb(75, 190, 102);
}

#hud-xp-bar .unity-progress-bar__progress {
    background-color: rgb(83, 139, 235);
}

.hud-label {
    -unity-font-style: bold;
    margin-right: 14px;
}

.hud-wave {
    -unity-font-style: bold;
    margin-right: 14px;
    padding: 2px 8px;
    border-radius: 4px;
    background-color: rgb(45, 51, 64);
    color: rgb(230, 230, 235);
}

.hud-wave--ordinary {
    background-color: rgb(45, 51, 64);
}

.hud-wave--pressure {
    background-color: rgb(176, 112, 32);
}

.hud-wave--elite {
    background-color: rgb(160, 40, 48);
}

.hud-wave--rest {
    background-color: rgb(40, 118, 88);
}

.hud-timer {
    flex-grow: 1;
    -unity-text-align: middle-center;
    font-size: 20px;
    -unity-font-style: bold;
}

.compact-button {
    min-width: 82px;
    height: 30px;
    margin-left: 4px;
    margin-right: 4px;
}

.fullscreen-overlay {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 7, 12, 0.72);
}

.dialog-panel {
    padding: 22px;
    background-color: rgb(29, 34, 45);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgb(80, 91, 112);
    border-right-color: rgb(80, 91, 112);
    border-top-color: rgb(80, 91, 112);
    border-bottom-color: rgb(80, 91, 112);
    border-radius: 8px;
}

.draft-panel {
    width: 92%;
    max-width: 1100px;
    max-height: 94%;
}

.result-panel {
    width: 80%;
    max-width: 1000px;
    max-height: 92%;
    align-items: center;
}

.dialog-title {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-font-definition: url("../../Fonts/AlegreyaSans-Medium.ttf");
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

.draft-controls,
.draft-option-row {
    flex-direction: row;
    align-items: center;
}

.draft-controls {
    justify-content: space-between;
    margin-bottom: 10px;
}

.draft-option-row {
    margin-top: 4px;
    margin-bottom: 4px;
}

.draft-option-select {
    flex-grow: 1;
    min-height: 180px;
    height: 260px;
    -unity-text-align: middle-left;
}

.draft-banish-mode .draft-option-select {
    border-color: rgb(235, 146, 109);
}

.draft-control-hint {
    white-space: normal;
    margin-bottom: 6px;
}

.primary-button {
    width: 180px;
    height: 38px;
}

.build-panel {
    position: absolute;
    top: 74px;
    right: 16px;
    width: 320px;
    padding: 10px;
    background-color: rgba(18, 22, 30, 0.86);
    border-radius: 6px;
}

.build-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(163, 190, 255);
    margin-bottom: 4px;
}

.build-passive-title {
    margin-top: 9px;
}

.build-slot {
    height: 42px;
    width: 42px;
    flex-shrink: 0;
    padding-left: 5px;
    -unity-text-align: middle-left;
    background-color: rgba(41, 48, 62, 0.9);
    margin-top: 1px;
    margin-bottom: 1px;
}

.build-slot-empty {
    color: rgb(104, 111, 126);
}

.development-toggle {
    display: none;
    position: absolute;
    left: 16px;
    bottom: 72px;
    width: 58px;
    height: 32px;
    -unity-font-style: bold;
}

.development-panel {
    display: none;
    position: absolute;
    left: 16px;
    bottom: 112px;
    width: 400px;
    max-height: 430px;
    flex-direction: column;
    padding: 10px;
    background-color: rgba(18, 22, 30, 0.9);
    border-radius: 6px;
}

.development-header,
.development-tabs,
.development-button-row {
    flex-direction: row;
    align-items: center;
}

.development-header {
    height: 30px;
}

.development-title {
    flex-grow: 1;
    -unity-font-style: bold;
}

.development-close {
    width: 30px;
    height: 26px;
    font-size: 18px;
}

.development-tabs {
    margin-top: 6px;
    margin-bottom: 8px;
}

.development-tab {
    flex-grow: 1;
    height: 30px;
    margin-right: 3px;
}

/* Buttons use an explicit dark fill so the light inherited text stays readable. */
.development-toggle,
.development-panel .unity-button,
.primary-button,
.compact-button,
.speed-button {
    background-color: rgb(52, 60, 78);
    color: rgb(240, 243, 248);
    border-color: rgb(92, 104, 128);
}

.development-toggle:hover,
.development-panel .unity-button:hover,
.primary-button:hover,
.compact-button:hover,
.speed-button:hover {
    background-color: rgb(66, 76, 98);
}

.development-panel .development-lock-active {
    background-color: rgb(150, 52, 44);
    border-color: rgb(220, 110, 96);
    -unity-font-style: bold;
}

.development-panel .development-tab-active {
    background-color: rgb(69, 91, 130);
    -unity-font-style: bold;
}

.development-pane {
    display: none;
    max-height: 330px;
    padding: 8px;
    background-color: rgba(41, 48, 62, 0.82);
    border-radius: 4px;
}

.development-scroll {
    height: 300px;
}

.development-section-title {
    margin-bottom: 7px;
    color: rgb(163, 190, 255);
    -unity-font-style: bold;
}

.hud-speed-controls { flex-direction: row; flex-shrink: 0; margin-right: 6px; }
.speed-button { min-width: 34px; height: 30px; margin-left: 2px; padding-left: 3px; padding-right: 3px; }
.speed-button--selected { background-color: rgb(75, 139, 235); color: rgb(255, 255, 255); -unity-font-style: bold; }

#playtest-note {
    flex-direction: column;
    margin-top: 8px;
    margin-bottom: 8px;
}

#playtest-note > .unity-base-field__label {
    min-width: 0;
    margin-bottom: 4px;
}

#playtest-note .unity-base-text-field__input {
    min-height: 52px;
    background-color: rgb(18, 22, 30);
    color: rgb(240, 243, 248);
    white-space: normal;
}

.development-section-spaced {
    margin-top: 12px;
}

.development-button-row {
    flex-wrap: wrap;
}

.development-button-wrap {
    max-width: 360px;
}

.showcase-button {
    min-width: 62px;
    margin-bottom: 6px;
}

.set-recipe-panel {
    flex-shrink: 0;
}

.set-recipe-progress {
    font-size: 11px;
    color: rgb(190, 204, 232);
}

.set-recipe-missed-header {
    font-size: 11px;
    margin-top: 4px;
    color: rgb(214, 150, 150);
}

.set-recipe-missed {
    color: rgb(150, 150, 160);
}

.character-selection-panel {
    flex-shrink: 0;
}

.character-entry {
    font-size: 11px;
    color: rgb(190, 232, 198);
    white-space: normal;
}

.development-help {
    margin-top: 8px;
    font-size: 11px;
    color: rgb(174, 182, 199);
    white-space: normal;
}

.book-currency {
    position: absolute;
    top: 70px;
    left: 16px;
    max-width: 260px;
    color: rgb(246, 208, 109);
    font-size: 16px;
}
.draft-book .dialog-title { color: rgb(246, 208, 109); }
.draft-queue { color: rgb(190, 190, 190); margin-bottom: 8px; }

/* IP-10A: shared cards remain readable before final icon assets exist. */
.content-card { padding: 10px; margin: 4px; min-width: 0; white-space: normal; background-color: rgb(41, 48, 62); border-width: 2px; border-color: rgb(80, 91, 112); }
.content-card:hover { background-color: rgb(54, 66, 86); border-color: rgb(163, 190, 255); }
.content-card:active { background-color: rgb(35, 43, 59); }
.content-card:disabled { opacity: 0.45; }
.content-card-selected { border-color: rgb(110, 220, 145); }
.content-card-locked { background-color: rgb(31, 33, 39); }
.content-card-icon { width: 32px; height: 32px; background-color: rgb(65, 75, 92); flex-shrink: 0; }
.content-card-title { -unity-font-style: bold; font-size: 16px; white-space: normal; }
.content-card-summary { white-space: normal; overflow: hidden; flex-shrink: 1; -unity-text-align: upper-left; }
.content-card-status, .card-recipe { white-space: normal; font-size: 12px; color: rgb(190, 204, 232); }
.draft-card-set { border-color: rgb(246, 208, 109); }
.draft-card-completing { border-color: rgb(110, 220, 145); }
.draft-options { flex-direction: row; flex-shrink: 0; }
.draft-options > .content-card { width: 31%; flex-grow: 1; }
.draft-details-scroll { height: 120px; min-height: 50px; flex-shrink: 1; }
.draft-details { white-space: normal; }
.pause-build { width: 100%; height: 550px; flex-shrink: 1; }
.pause-build-grid { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.pause-build-grid > .content-card { width: 31%; min-height: 120px; }
#build-active-slots, #build-passive-slots, #build-sets { flex-direction: row; flex-wrap: wrap; }
.boss-bar { position: absolute; top: 60px; left: 25%; right: 25%; height: 30px; display: none; }
.boss-bar .unity-progress-bar__progress { background-color: rgb(177, 58, 42); }
#hud-timer { position: absolute; top: 16px; left: 40%; right: 40%; height: 32px; }

.pickup-feedback { position: absolute; left: 35%; right: 35%; top: 18%; -unity-text-align: middle-center; font-size: 22px; color: rgb(195, 240, 165); display: none; }

.traveler-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.traveler-item { position: absolute; width: 120px; height: 46px; margin-left: -60px; margin-top: -23px; color: rgb(250, 211, 90); -unity-text-align: middle-center; font-size: 15px; }
.traveler-item ProgressBar { height: 12px; }
.traveler-pointer { background-color: rgba(20, 20, 25, 0.8); }

/* DECISION-0081: production vertical slice — HUD, Draft and Pause / Build. */
.gameplay-root {
    color: var(--folio-parchment);
}

.field-folio-panel {
    background-color: rgba(48, 41, 54, 0.96);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--folio-deep-plum);
    border-right-color: var(--folio-deep-plum);
    border-top-color: var(--folio-deep-plum);
    border-bottom-color: var(--folio-deep-plum);
    border-radius: 12px;
}

.hud-row {
    bottom: 18px;
    left: 24px;
    right: 24px;
    height: 58px;
    padding-left: 14px;
    padding-right: 14px;
    background-color: rgba(48, 41, 54, 0.94);
}

.hud-bar {
    width: 250px;
    height: 30px;
    margin-right: 16px;
    color: var(--folio-parchment);
    -unity-font-style: bold;
}

.hud-bar .unity-progress-bar__background {
    background-color: var(--folio-deep-plum);
    border-radius: 6px;
}

.hud-bar .unity-progress-bar__progress {
    background-color: var(--folio-moss);
    border-radius: 5px;
}

#hud-xp-bar .unity-progress-bar__progress {
    background-color: var(--folio-azure);
}

.hud-bar .unity-progress-bar__title {
    color: var(--folio-parchment);
    -unity-font-style: bold;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--folio-deep-plum);
}

.hud-label {
    color: var(--folio-parchment);
    font-size: 16px;
    -unity-font-definition: url("../../Fonts/AlegreyaSans-Medium.ttf");
}

.hud-wave {
    min-width: 150px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-radius: 7px;
    background-color: var(--folio-raised-panel);
    color: var(--folio-parchment);
    -unity-font-definition: url("../../Fonts/AlegreyaSans-Medium.ttf");
}

.hud-wave--ordinary { background-color: var(--folio-raised-panel); }
.hud-wave--pressure { background-color: var(--folio-leather-rust); }
.hud-wave--elite { background-color: var(--folio-coral); }
.hud-wave--rest { background-color: var(--folio-moss); }

#hud-timer {
    top: 18px;
    left: 42%;
    right: 42%;
    height: 38px;
    color: var(--folio-parchment);
    font-size: 28px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: var(--folio-deep-plum);
}

.build-panel {
    top: 76px;
    right: 24px;
    width: 340px;
    padding: 12px;
    background-color: rgba(48, 41, 54, 0.92);
}

.build-title {
    margin-left: 2px;
    margin-bottom: 6px;
    color: var(--folio-muted-parchment);
    font-size: 13px;
}

.build-passive-title {
    margin-top: 12px;
}

.build-slot {
    width: 48px;
    height: 48px;
    margin-right: 4px;
    margin-bottom: 4px;
    padding-right: 4px;
    padding-bottom: 3px;
    background-color: var(--folio-deep-plum);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--folio-raised-panel);
    border-right-color: var(--folio-raised-panel);
    border-top-color: var(--folio-raised-panel);
    border-bottom-color: var(--folio-raised-panel);
    border-radius: 8px;
    color: var(--folio-parchment);
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: lower-right;
    -unity-background-scale-mode: scale-to-fit;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--folio-deep-plum);
}

.build-slot-set {
    border-left-color: var(--folio-gold);
    border-right-color: var(--folio-gold);
    border-top-color: var(--folio-gold);
    border-bottom-color: var(--folio-gold);
}

.build-slot-empty {
    color: var(--folio-muted-parchment);
    opacity: 0.48;
    -unity-text-align: middle-center;
}

.fullscreen-overlay {
    background-color: rgba(36, 27, 43, 0.82);
}

.dialog-panel {
    padding: 28px;
    background-color: var(--folio-charcoal-plum);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--folio-deep-plum);
    border-right-color: var(--folio-deep-plum);
    border-top-color: var(--folio-deep-plum);
    border-bottom-color: var(--folio-deep-plum);
    border-radius: 14px;
}

.dialog-title {
    color: var(--folio-parchment);
    font-size: 32px;
    margin-bottom: 10px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: var(--folio-deep-plum);
}

.draft-panel {
    width: 88%;
    max-width: 1240px;
    max-height: 94%;
}

.draft-queue {
    min-height: 22px;
    margin-bottom: 10px;
    color: var(--folio-muted-parchment);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.draft-controls {
    min-height: 42px;
    margin-bottom: 10px;
    padding-left: 4px;
    padding-right: 4px;
}

.draft-control-hint {
    margin-bottom: 10px;
    color: var(--folio-muted-parchment);
    font-size: 15px;
    -unity-text-align: middle-center;
}

.folio-button,
.primary-button,
.compact-button,
.speed-button {
    background-color: var(--folio-raised-panel);
    color: var(--folio-parchment);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--folio-deep-plum);
    border-right-color: var(--folio-deep-plum);
    border-top-color: var(--folio-deep-plum);
    border-bottom-color: var(--folio-deep-plum);
    border-radius: 8px;
    transition-property: background-color, border-color, scale, translate, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.folio-button:hover,
.primary-button:hover,
.compact-button:hover,
.speed-button:hover {
    background-color: #55485C;
    border-left-color: var(--folio-muted-parchment);
    border-right-color: var(--folio-muted-parchment);
    border-top-color: var(--folio-muted-parchment);
    border-bottom-color: var(--folio-muted-parchment);
    translate: 0 -2px;
}

.folio-button:focus,
.primary-button:focus,
.compact-button:focus,
.speed-button:focus,
.content-card:focus {
    border-left-color: var(--folio-parchment);
    border-right-color: var(--folio-parchment);
    border-top-color: var(--folio-parchment);
    border-bottom-color: var(--folio-parchment);
}

.folio-button:active,
.primary-button:active,
.compact-button:active,
.speed-button:active {
    background-color: var(--folio-deep-plum);
    translate: 0 1px;
    scale: 0.99 0.99;
}

.folio-button:disabled,
.primary-button:disabled,
.compact-button:disabled,
.speed-button:disabled {
    opacity: 0.48;
    translate: 0 0;
}

.folio-button-primary,
.primary-button {
    background-color: var(--folio-leather-rust);
    color: var(--folio-parchment);
    -unity-font-style: bold;
}

.draft-action {
    min-width: 150px;
    height: 38px;
    font-size: 16px;
}

.speed-button {
    min-width: 38px;
    height: 34px;
    margin-left: 3px;
}

.speed-button--selected {
    background-color: var(--folio-azure);
    border-left-color: var(--folio-parchment);
    border-right-color: var(--folio-parchment);
    border-top-color: var(--folio-parchment);
    border-bottom-color: var(--folio-parchment);
}

.content-card {
    min-width: 0;
    margin: 6px;
    padding: 16px;
    background-color: var(--folio-raised-panel);
    color: var(--folio-parchment);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--folio-deep-plum);
    border-right-color: var(--folio-deep-plum);
    border-top-color: var(--folio-deep-plum);
    border-bottom-color: var(--folio-deep-plum);
    border-radius: 12px;
    transition-property: background-color, border-color, translate, scale, opacity;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.content-card:hover {
    background-color: #55485C;
    border-left-color: var(--folio-muted-parchment);
    border-right-color: var(--folio-muted-parchment);
    border-top-color: var(--folio-muted-parchment);
    border-bottom-color: var(--folio-muted-parchment);
    translate: 0 -3px;
}

.content-card:active {
    background-color: var(--folio-deep-plum);
    translate: 0 1px;
    scale: 0.99 0.99;
}

.content-card:disabled {
    opacity: 0.46;
    translate: 0 0;
}

.content-card-selected {
    border-left-color: var(--folio-leather-rust);
    border-right-color: var(--folio-leather-rust);
    border-top-color: var(--folio-leather-rust);
    border-bottom-color: var(--folio-leather-rust);
}

.content-card-locked {
    background-color: #2B2730;
    color: var(--folio-muted-parchment);
}

.content-card-type {
    align-self: flex-start;
    margin: 0;
    padding: 0;
    color: #A9C2D0;
    font-size: 24px;
    -unity-font-style: bold;
    -unity-font-definition: url("../../Fonts/AlegreyaSans-Medium.ttf");
    -unity-text-align: middle-left;
}

.draft-type-passive .content-card-type { color: #A3B986; }
.draft-type-set .content-card-type { color: var(--folio-gold); }
.draft-type-other .content-card-type { color: var(--folio-muted-parchment); }

.draft-option-select {
    min-height: 310px;
    height: 350px;
    padding: 18px;
    -unity-text-align: upper-left;
}

.draft-option-select .content-card-icon {
    margin: 0 18px 0 0;
    background-color: transparent;
    -unity-background-scale-mode: scale-to-fit;
}

.draft-option-select .content-card-title {
    margin: 10px 0 7px 0;
    color: var(--folio-parchment);
    font-size: 26px;
    -unity-font-definition: url("../../Fonts/AlegreyaSans-Medium.ttf");
    -unity-text-align: middle-left;
}

.draft-option-select .content-card-summary {
    color: var(--folio-parchment);
    font-size: 17px;
    -unity-text-align: upper-left;
}

.content-card-status,
.card-recipe {
    margin-top: 6px;
    color: var(--folio-muted-parchment);
    font-size: 14px;
}

.draft-card-related {
    border-bottom-color: var(--folio-violet);
    border-bottom-width: 5px;
}

.draft-card-set,
.draft-card-completing {
    border-left-color: var(--folio-gold);
    border-right-color: var(--folio-gold);
    border-top-color: var(--folio-gold);
    border-bottom-color: var(--folio-gold);
}

.draft-banish-mode .draft-option-select {
    border-left-color: var(--folio-coral);
    border-right-color: var(--folio-coral);
    border-top-color: var(--folio-coral);
    border-bottom-color: var(--folio-coral);
}

.draft-details-scroll {
    height: 110px;
    min-height: 64px;
    margin-top: 10px;
    padding: 10px;
    background-color: var(--folio-deep-plum);
    border-radius: 8px;
}

.draft-details {
    color: var(--folio-muted-parchment);
    font-size: 15px;
}

.draft-book .dialog-title {
    color: var(--folio-gold);
}

.pause-panel {
    width: 86%;
    max-width: 1240px;
    max-height: 92%;
    align-items: stretch;
}

.pause-character {
    margin-bottom: 14px;
    padding: 12px;
    background-color: var(--folio-deep-plum);
    border-radius: 8px;
    color: var(--folio-parchment);
    font-size: 17px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.pause-build {
    width: 100%;
    height: 590px;
    flex-shrink: 1;
    padding-right: 8px;
}

.pause-section-title {
    margin-top: 16px;
    margin-bottom: 6px;
    padding-bottom: 5px;
    color: var(--folio-muted-parchment);
    font-size: 15px;
    -unity-font-style: bold;
    -unity-font-definition: url("../../Fonts/AlegreyaSans-Medium.ttf");
    border-bottom-width: 2px;
    border-bottom-color: var(--folio-deep-plum);
}

.pause-section-title-missed {
    color: var(--folio-coral);
}

.pause-build-grid {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

.pause-build-grid > .content-card {
    width: 31%;
    min-height: 136px;
}

.pause-build-grid-active > .content-card {
    border-bottom-width: 5px;
    border-bottom-color: var(--folio-leather-rust);
}

.pause-build-grid-passive > .content-card {
    border-bottom-width: 5px;
    border-bottom-color: var(--folio-moss);
}

.pause-set-card,
.pause-recipe-card {
    min-height: 112px;
}

.pause-set-card {
    border-left-color: var(--folio-gold);
    border-right-color: var(--folio-gold);
    border-top-color: var(--folio-gold);
    border-bottom-color: var(--folio-gold);
}

.pause-recipe-card {
    border-left-width: 5px;
    border-left-color: var(--folio-violet);
}

.pause-missed-card {
    border-left-color: var(--folio-coral);
}

.pause-build .content-card-icon {
    width: 64px;
    height: 64px;
    align-self: center;
    margin-bottom: 8px;
    background-color: var(--folio-deep-plum);
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.pause-build .content-card-title {
    color: var(--folio-parchment);
    font-size: 18px;
    -unity-font-definition: url("../../Fonts/AlegreyaSans-Medium.ttf");
    -unity-text-align: middle-center;
}

.pause-build .content-card-summary {
    color: var(--folio-muted-parchment);
    font-size: 15px;
}

.pause-panel .primary-button {
    align-self: center;
    width: 220px;
    height: 48px;
    margin-top: 14px;
    font-size: 18px;
}


.boss-bar {
    top: 66px;
    left: 28%;
    right: 28%;
    height: 34px;
    color: var(--folio-parchment);
}

.boss-bar .unity-progress-bar__background { background-color: var(--folio-deep-plum); }
.boss-bar .unity-progress-bar__progress { background-color: var(--folio-coral); }

/* DECISION-0086: approved R2 composition. Physical-pixel compact profile is
   selected from panel geometry; no CSS media queries or scaled tiny type. */
.gameplay-root { font-size: 18px; }
.gameplay-root #hud-timer {
    left: 50%; right: auto; top: 18px; width: 108px; height: 40px;
    margin-left: -54px; font-size: 27px;
    background-color: rgba(48, 41, 54, 0.92); border-radius: 10px; -unity-text-outline-width: 0;
}
.player-health-anchor {
    position: absolute; width: 64px; height: 10px; min-height: 10px; max-height: 10px; margin: 0; padding: 0;
}
.player-health-anchor .unity-progress-bar__container { height: 10px; min-height: 0; max-height: 10px; margin: 0; padding: 0; }
.player-health-anchor .unity-progress-bar__title { display: none; }
.player-health-anchor .unity-progress-bar__background { height: 10px; min-height: 0; margin: 0; padding: 0; }
.player-health-anchor .unity-progress-bar__progress { height: 10px; min-height: 0; }
.build-panel {
    top: auto; right: auto; bottom: 22px; left: 24px; width: 328px;
    padding: 0; background-color: transparent;
}
.build-slot { width: 50px; height: 50px; margin: 0 4px 4px 0; font-size: 13px; }
.hud-xp-row { flex-direction: row; align-items: center; margin-top: 3px; }
.hud-xp-row .hud-label { width: 44px; margin-right: 8px; }
.hud-xp-row .hud-xp-bar { flex-grow: 1; width: auto; height: 10px; margin: 0 4px 0 0; }
.hud-xp-bar .unity-progress-bar__background, .hud-xp-bar .unity-progress-bar__progress { height: 10px; min-height: 0; margin: 0; padding: 0; }
.hud-xp-bar, .hud-xp-bar .unity-progress-bar__container { min-height: 0; max-height: 10px; height: 10px; margin: 0; padding: 0; }
.hud-sets { position: absolute; right: 24px; bottom: 22px; max-width: 340px; justify-content: flex-end; }
.development-toggle { bottom: auto; top: 16px; left: 16px; }
.development-panel { bottom: auto; top: 56px; left: 16px; }
.draft-panel { width: 84%; max-width: 1340px; height: 850px; max-height: 94%; }
.draft-options { flex-direction: row; flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 0; }
.draft-card { width: 33.333%; height: 100%; padding: 0 7px; min-width: 0; min-height: 0; border-width: 0; }
.draft-card .draft-option-select {
    width: 100%; height: auto; min-height: 0; flex-grow: 1; flex-shrink: 1; flex-basis: 0;
    margin: 0; padding: 18px; align-items: stretch;
}
.draft-card .content-card-icon { width: 112px; height: 112px; flex-shrink: 0; }
.draft-card-header { flex-direction: row; align-items: center; flex-shrink: 0; }
.draft-card-meta { flex-grow: 1; min-width: 0; }
.draft-card .content-card-summary { white-space: normal; flex-shrink: 1; font-size: 19px; }
.draft-summary-scroll { flex-grow: 1; flex-shrink: 1; min-height: 36px; margin: 2px 0; }
.draft-summary-scroll .content-card-summary { flex-shrink: 0; overflow: visible; }
.draft-card .card-level { color: var(--folio-muted-parchment); margin: 6px 0 0 0; font-size: 21px; white-space: normal; -unity-text-align: middle-left; }
.draft-card .card-recipe { margin-top: auto; padding-top: 8px; }
.draft-confirm { height: 44px; flex-shrink: 0; margin: 8px 0 0 0; font-size: 18px; }
.draft-card-inspected .draft-option-select { border-color: var(--folio-leather-rust); }
.draft-card-inspected .draft-confirm { background-color: var(--folio-leather-rust); }
.draft-card-set .draft-option-select { border-bottom-color: var(--folio-gold); }
.recipe-inspector { height: 228px; flex-shrink: 0; flex-direction: row; margin: 14px 7px; padding: 16px; }
.recipe-list { width: 34%; flex-shrink: 0; margin-right: 18px; }
.recipe-list-item {
    min-height: 38px; margin: 0 4px 6px 0; padding: 6px 10px; white-space: normal;
    flex-direction: row; align-items: center; flex-shrink: 0;
    background-color: var(--folio-deep-plum); color: var(--folio-parchment); border-width: 1px;
    border-color: var(--folio-raised-panel); border-radius: 6px; -unity-text-align: middle-left;
}
.recipe-list-icon { width: 28px; height: 28px; margin-right: 8px; flex-shrink: 0; }
.recipe-list-name { flex-grow: 1; flex-shrink: 1; min-width: 0; margin: 0; padding: 0; white-space: normal; }
.recipe-list-progress { flex-shrink: 0; margin-left: 8px; font-size: 14px; color: var(--folio-muted-parchment); }
.recipe-list-item.recipe-selected { border-color: var(--folio-gold); }
.recipe-list-item:focus { border-color: var(--folio-parchment); }
.recipe-inspection { flex-grow: 1; min-width: 0; }
.recipe-title { font-size: 24px; color: var(--folio-gold); white-space: normal; -unity-font-definition: url("../../Fonts/AlegreyaSans-Medium.ttf"); }
.recipe-effect { white-space: normal; font-size: 18px; color: var(--folio-parchment); margin: 6px 0 10px 0; }
.draft-details { white-space: normal; font-size: 18px; }
.draft-component { white-space: normal; margin: 1px 0; padding: 0; color: var(--folio-muted-parchment); }
.draft-component-met { color: #A3B986; }
.draft-controls { flex-shrink: 0; margin: 0 7px; justify-content: center; }
.draft-control-hint { display: none; }
.pause-panel { width: 90%; max-width: 1560px; height: 840px; max-height: 92%; }
.pause-columns { flex-direction: row; flex-grow: 1; min-height: 0; }
.pause-left { width: 34%; margin-right: 18px; padding: 18px; }
.pause-right { flex-grow: 1; min-width: 0; padding: 18px; }
.pause-character-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.pause-portrait { width: 140px; height: 120px; flex-shrink: 0; margin-right: 16px; -unity-background-scale-mode: scale-to-fit; }
.pause-character { flex-grow: 1; font-size: 21px; margin: 0; padding: 0; background-color: transparent; -unity-text-align: middle-left; }
.pause-stats { white-space: normal; margin: 16px 0 10px 0; font-size: 18px; }
.pause-section-title { margin-top: 10px; margin-bottom: 6px; padding-bottom: 4px; font-size: 19px; }
.pause-build { height: auto; flex-grow: 1; min-height: 0; padding: 0; }
.pause-slot { width: 50%; min-width: 0; height: 48px; flex-direction: row; align-items: center; padding: 4px; font-size: 16px; }
.pause-slot-icon { width: 34px; height: 34px; flex-shrink: 0; margin-right: 6px; }
.pause-slot-name { flex-grow: 1; min-width: 0; white-space: normal; }
.pause-slot-empty { opacity: 0.4; }
.set-group-items { flex-direction: row; flex-wrap: wrap; }
.set-group-received, .set-group-missed { border-left-width: 3px; padding-left: 10px; margin-bottom: 10px; }
.set-group-received { border-left-color: var(--folio-gold); }
.set-group-missed { border-left-color: var(--folio-muted-parchment); }
.set-group-progress { margin-bottom: 10px; }
.pause-set-chip, .pause-recipe-card {
    color: var(--folio-parchment); background-color: var(--folio-raised-panel); border-color: var(--folio-deep-plum);
    border-width: 1px; border-radius: 6px; white-space: normal; -unity-text-align: upper-left;
}
.pause-set-chip { margin: 3px 8px 3px 0; padding: 5px 8px; max-width: 100%; }
.set-name-row { flex-direction: row; align-items: center; }
.set-icon { width: 32px; height: 32px; flex-shrink: 0; margin-right: 7px; }
.set-name { white-space: normal; font-size: 18px; flex-shrink: 1; }
.pause-recipe-card { width: 32%; min-width: 0; min-height: 0; margin: 4px 1% 5px 0; padding: 10px; }
.pause-recipe-card .set-name { font-size: 19px; }
.recipe-progress { font-size: 15px; color: var(--folio-gold); margin: 8px 0 5px 0; white-space: normal; }
.recipe-components { white-space: normal; font-size: 15px; color: var(--folio-muted-parchment); }
.pause-set-chip:hover, .pause-recipe-card:hover { background-color: #55485C; }
.pause-set-chip:focus, .pause-recipe-card:focus { border-color: var(--folio-parchment); }
.pause-footer { flex-direction: row; justify-content: center; align-items: center; flex-shrink: 0; height: 70px; }
.pause-footer .shell-pause { flex-direction: row; }
.pause-footer .unity-button {
    height: 46px; width: 220px; margin: 12px 5px 0 5px; font-size: 18px;
    color: var(--folio-parchment); background-color: var(--folio-raised-panel); border-color: var(--folio-deep-plum); border-radius: 8px;
}
.pause-footer .primary-button { background-color: var(--folio-leather-rust); }
.pause-footer .unity-button:hover { background-color: #55485C; }
.pause-footer .unity-button:focus { border-color: var(--folio-parchment); }
.set-popup {
    -unity-font-definition: url("../../Fonts/PTSans-Regular.ttf");
    position: absolute; height: 170px; padding: 18px; padding-right: 42px;
    background-color: var(--folio-deep-plum); color: var(--folio-parchment);
    border-width: 2px; border-color: var(--folio-gold); border-radius: 10px;
}
.set-popup .recipe-title { font-size: 22px; }
.set-popup .recipe-effect { font-size: 16px; }
.set-popup-close { position: absolute; right: 6px; top: 6px; width: 28px; height: 28px; background-color: var(--folio-raised-panel); color: var(--folio-parchment); border-width: 1px; border-color: var(--folio-gold); border-radius: 4px; }
.gameplay-root .unity-scroller--vertical { width: 10px; margin-left: 5px; }
.gameplay-root .unity-scroller__low-button, .gameplay-root .unity-scroller__high-button { display: none; }
.gameplay-root .unity-scroller .unity-base-slider__tracker { background-color: var(--folio-deep-plum); border-width: 0; border-radius: 4px; }
.gameplay-root .unity-scroller .unity-base-slider__dragger { background-color: var(--folio-muted-parchment); border-width: 0; border-radius: 4px; min-height: 24px; }
.gameplay-root .unity-scroller--vertical .unity-base-slider__dragger { width: 6px; min-width: 6px; max-width: 6px; left: 1px; }
.gameplay-root .unity-scroll-view__horizontal-scroller { display: none; }

.ui-compact .gameplay-root { font-size: 16px; }
.ui-compact .build-panel { left: 16px; bottom: 16px; width: 208px; }
.ui-compact .build-slot { width: 30px; height: 30px; font-size: 12px; border-radius: 5px; padding: 0 1px 0 0; }
.ui-compact .hud-sets { right: 16px; bottom: 16px; max-width: 210px; }
.ui-compact .hud-xp-row .hud-xp-bar { height: 7px; }
.ui-compact .hud-xp-bar .unity-progress-bar__background, .ui-compact .hud-xp-bar .unity-progress-bar__progress { height: 7px; }
.ui-compact .hud-xp-bar, .ui-compact .hud-xp-bar .unity-progress-bar__container { height: 7px; max-height: 7px; }
.ui-compact .hud-label { font-size: 15px; }
.ui-compact #hud-timer { width: 88px; height: 32px; margin-left: -44px; top: 12px; font-size: 23px; }
.ui-compact .draft-panel { width: 84%; height: 636px; }
.ui-compact .dialog-title { font-size: 28px; margin-bottom: 6px; }
.ui-compact .draft-queue { min-height: 18px; margin-bottom: 6px; font-size: 14px; }
.ui-compact .draft-card .draft-option-select { padding: 12px; }
.ui-compact .draft-card .content-card-icon { width: 88px; height: 88px; margin-right: 14px; }
.ui-compact .draft-card .content-card-type { font-size: 21px; }
.ui-compact .draft-card .card-level { font-size: 18px; }
.ui-compact .draft-card .content-card-title { font-size: 23px; }
.ui-compact .draft-card .content-card-summary { font-size: 16px; }
.ui-compact .draft-confirm { height: 36px; font-size: 16px; margin-top: 6px; }
.ui-compact .recipe-inspector { height: 172px; margin-top: 10px; margin-bottom: 8px; padding: 10px; }
.ui-compact .recipe-title { font-size: 21px; }
.ui-compact .recipe-effect, .ui-compact .draft-details { font-size: 15px; }
.ui-compact .recipe-list-item { font-size: 15px; min-height: 32px; }
.ui-compact .recipe-list-icon { width: 24px; height: 24px; margin-right: 6px; }
.ui-compact .recipe-list-progress { font-size: 12px; margin-left: 6px; }
.ui-compact .pause-panel { width: 92%; height: 630px; }
.ui-compact .pause-left { padding: 12px; margin-right: 12px; }
.ui-compact .pause-right { padding: 12px; }
.ui-compact .pause-portrait { width: 100px; height: 96px; margin-right: 12px; }
.ui-compact .pause-character { font-size: 18px; }
.ui-compact .pause-stats { font-size: 15px; margin-top: 10px; margin-bottom: 6px; }
.ui-compact .pause-section-title { font-size: 17px; margin-top: 7px; }
.ui-compact .pause-slot { height: 41px; font-size: 14px; padding: 3px; }
.ui-compact .pause-slot-icon { width: 28px; height: 28px; margin-right: 4px; }
.ui-compact .pause-recipe-card { width: 48%; margin-right: 2%; padding: 9px; }
.ui-compact .pause-recipe-card .set-name { font-size: 17px; }
.ui-compact .set-icon { width: 28px; height: 28px; }
.ui-compact .set-name { font-size: 16px; }
.ui-compact .recipe-components, .ui-compact .recipe-progress { font-size: 14px; }
.ui-compact .pause-footer { height: 58px; }
.ui-compact .pause-footer .unity-button { height: 40px; width: 184px; font-size: 16px; }
