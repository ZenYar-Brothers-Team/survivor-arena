<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="gameplay-ui-root" class="gameplay-root" picking-mode="Ignore">
        <ui:VisualElement name="traveler-overlay" class="traveler-overlay" picking-mode="Ignore" />
        <ui:Label name="hud-timer" text="00:00" class="hud-timer" picking-mode="Ignore" />
        <ui:ProgressBar name="hud-health-bar" title="" low-value="0" high-value="100" class="hud-bar hud-health-bar player-health-anchor" picking-mode="Ignore" />

        <ui:ProgressBar name="hud-boss-bar" title="" low-value="0" high-value="100" class="boss-bar" picking-mode="Ignore" />
        <ui:Label name="hud-notification" class="hud-notification" picking-mode="Ignore" />
        <ui:Label name="hud-book-currency" class="book-currency" picking-mode="Ignore" />
        <ui:Label name="hud-pickup-feedback" class="pickup-feedback" picking-mode="Ignore" />

        <ui:VisualElement name="build-panel" class="build-panel" picking-mode="Ignore">
            <ui:VisualElement name="build-active-slots" />
            <ui:VisualElement name="build-passive-slots" />
            <ui:VisualElement class="hud-xp-row" picking-mode="Ignore">
                <ui:Label name="hud-level" text="Ур. 1" class="hud-label" picking-mode="Ignore" />
                <ui:ProgressBar name="hud-xp-bar" title="" low-value="0" high-value="100" class="hud-bar hud-xp-bar" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="build-sets" class="hud-sets" picking-mode="Ignore" />

        <ui:VisualElement name="draft-overlay" class="fullscreen-overlay">
            <ui:VisualElement class="draft-panel">
                <ui:Label name="draft-heading" text="Выбери улучшение" class="dialog-title" />
                <ui:Label name="draft-queue" class="draft-queue" />
                <ui:VisualElement name="draft-options" class="draft-options" />
                <ui:VisualElement name="draft-recipe-inspector" class="recipe-inspector field-folio-panel">
                    <ui:ScrollView name="draft-recipe-list" class="recipe-list" mode="Vertical" />
                    <ui:ScrollView class="recipe-inspection" mode="Vertical">
                        <ui:Label name="draft-recipe-title" class="recipe-title" />
                        <ui:Label name="draft-recipe-effect" class="recipe-effect" />
                        <ui:VisualElement name="draft-details" class="draft-details" picking-mode="Ignore" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement class="draft-controls">
                    <ui:Button name="draft-reroll" text="Reroll" class="compact-button folio-button draft-action" />
                    <ui:Button name="draft-banish-mode" text="Banish" class="compact-button folio-button draft-action" />
                    <ui:Label name="draft-banish-count" text="Banish: 0" class="hud-label" />
                </ui:VisualElement>
                <ui:Label name="draft-control-hint" class="draft-control-hint" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="run-overlay" class="fullscreen-overlay">
            <ui:VisualElement class="pause-panel">
                <ui:Label name="run-overlay-title" text="Передышка" class="dialog-title" />
                <ui:VisualElement class="pause-columns">
                    <ui:VisualElement class="pause-left field-folio-panel">
                        <ui:VisualElement class="pause-character-row">
                            <ui:Image name="pause-portrait" class="pause-portrait" picking-mode="Ignore" />
                            <ui:Label name="pause-character" class="pause-character" />
                        </ui:VisualElement>
                        <ui:Label name="pause-stats" class="pause-stats" />
                        <ui:VisualElement name="pause-slots" />
                    </ui:VisualElement>
                    <ui:VisualElement class="pause-right field-folio-panel">
                        <ui:Label text="Сеты" class="recipe-title" />
                        <ui:ScrollView name="pause-build" class="pause-build" mode="Vertical" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="pause-footer" class="pause-footer">
                    <ui:Button name="run-overlay-resume" text="Продолжить" class="primary-button folio-button folio-button-primary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Button name="development-toggle" text="DEV" class="development-toggle" />
        <ui:VisualElement name="development-panel" class="development-panel">
            <ui:VisualElement class="development-header">
                <ui:Label text="DEVELOPMENT" class="development-title" />
                <ui:Button name="development-close" text="×" class="development-close" />
            </ui:VisualElement>
            <ui:VisualElement class="development-tabs">
                <ui:Button name="development-tab-run" text="Run" class="development-tab" />
                <ui:Button name="development-tab-build" text="Build" class="development-tab" />
                <ui:Button name="development-tab-presentation" text="Presentation" class="development-tab" />
                <ui:Button name="development-tab-playtest" text="Playtest" class="development-tab" />
            </ui:VisualElement>
            <ui:ScrollView name="development-pane-run" class="development-pane development-scroll">
                <ui:Label text="RUN CONTROLS" class="development-section-title" />
                <ui:VisualElement class="hud-speed-controls">
                    <ui:Button name="hud-speed-1" text="1×" class="speed-button" />
                    <ui:Button name="hud-speed-2" text="2×" class="speed-button" />
                    <ui:Button name="hud-speed-3" text="3×" class="speed-button" />
                    <ui:Button name="hud-speed-5" text="5×" class="speed-button" />
                </ui:VisualElement>
                <ui:Label name="hud-wave" class="hud-wave" />
                <ui:VisualElement class="development-button-row">
                    <ui:Button name="development-add-xp" text="+5 XP" class="compact-button" />
                    <ui:Button name="development-add-xp-100" text="+100 XP" class="compact-button" />
                    <ui:Button name="development-damage" text="-10 HP" class="compact-button" />
                    <ui:Button name="development-heal" text="+10 HP" class="compact-button" />
                    <ui:Button name="development-health-lock" text="Lock HP" class="compact-button" tooltip="Freeze current HP (god mode for testing)" />
                </ui:VisualElement>
                <ui:Label text="ENEMY FIXTURE" class="development-section-title development-section-spaced" />
                <ui:Label name="development-enemy-observation" text="Enemy fixtures unavailable" class="development-help" />
                <ui:Label text="WAVE DIRECTOR" class="development-section-title development-section-spaced" />
                <ui:Label name="development-wave-observation" text="Wave director unavailable" class="development-help" />
                <ui:Label text="CURRENT STATS" class="development-section-title development-section-spaced" />
                <ui:Label name="development-experience-observation" text="XP unavailable" class="development-help" />
                <ui:Label name="development-stats-observation" text="Stats unavailable" class="development-help" />
            </ui:ScrollView>
            <ui:ScrollView name="development-pane-build" class="development-pane development-scroll">
                <ui:Label name="development-traveler-observation" class="observation-label" />
                <ui:Button name="development-spawn-traveler" text="Spawn fixture Traveler" class="compact-button" />
                <ui:Label name="development-pickup-observation" class="observation-label" />
                <ui:Button name="development-drop-potion" text="Drop fixture potion" class="compact-button" />
                <ui:Button name="development-drop-book" text="Drop fixture Book" class="compact-button" />
                <ui:Button name="development-add-book" text="Collect fixture Book" class="compact-button" />
                <ui:Button name="development-add-rerolls" text="+100 rerolls" class="compact-button" />
                <ui:Button name="development-unlock-all" text="Unlock all skills/passives/sets (run)" class="compact-button" />
                <ui:Label text="SET RECIPES" class="development-section-title" />
                <ui:VisualElement name="development-set-recipes" class="set-recipe-panel" />
                <ui:Label text="ACTIVE SKILLS" class="development-section-title development-section-spaced" />
                <ui:Label name="development-skill-observation" class="development-help" />
                <ui:Label text="CHARACTERS" class="development-section-title development-section-spaced" />
                <ui:VisualElement name="development-character-selection" class="character-selection-panel" />
            </ui:ScrollView>
            <ui:VisualElement name="development-pane-presentation" class="development-pane">
                <ui:Label text="PRESENTATION PREVIEW" class="development-section-title" />
                <ui:VisualElement class="development-button-row development-button-wrap">
                    <ui:Button name="development-presentation-live" text="Live" class="compact-button showcase-button" />
                    <ui:Button name="development-presentation-idle" text="Idle" class="compact-button showcase-button" />
                    <ui:Button name="development-presentation-left" text="Left" class="compact-button showcase-button" />
                    <ui:Button name="development-presentation-right" text="Right" class="compact-button showcase-button" />
                    <ui:Button name="development-presentation-reset" text="Reset" class="compact-button showcase-button" />
                </ui:VisualElement>
                <ui:Label text="Use -10 HP on the Run tab for hit reaction. Escape / Space / RMB to pause." class="development-help" />
            </ui:VisualElement>
            <ui:ScrollView name="development-pane-playtest" class="development-pane development-scroll">
                <ui:Label text="LOCAL PLAYTEST" class="development-section-title" />
                <ui:Label name="playtest-summary" text="Recording disabled" class="development-help" />
                <ui:TextField name="playtest-note" label="Note" multiline="true" />
                <ui:VisualElement class="development-button-row">
                    <ui:Button name="playtest-marker" text="Add marker" class="compact-button" />
                    <ui:Button name="playtest-export" text="Export" class="compact-button" />
                </ui:VisualElement>
                <ui:Label text="Local files only. Export during a run is incomplete. Final export is automatic; add later notes to feedback.md." class="development-help" />
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
