.character-select-screen {
    flex-grow: 1;
    background-color: rgb(27, 25, 34);
    color: rgb(241, 232, 211);
    padding: 48px;
    align-items: center;
}
.character-select-title { font-size: 38px; margin-bottom: 12px; }
.character-select-subtitle { font-size: 18px; margin-bottom: 24px; color: rgb(188, 182, 171); }
.character-select-scroll { width: 100%; flex-grow: 1; }
.character-select-cards { flex-direction: row; flex-wrap: wrap; justify-content: center; }
.character-select-card { width: 400px; min-height: 500px; margin: 16px; padding: 24px; white-space: normal; }
.character-select-card .content-card-summary { font-size: 20px; white-space: normal; }
.character-select-crop { width: 240px; height: 240px; align-self: center; margin-bottom: 16px; }
.character-select-start { width: 320px; height: 64px; font-size: 26px; margin-top: 24px; }
