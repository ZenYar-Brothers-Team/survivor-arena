.entry-root { flex-grow: 1; }
.entry-page, .entry-menu, .entry-root .shell-back { color: #e8d8b8; -unity-font-definition: url("project://database/Assets/Game/UI/Fonts/PTSans-Regular.ttf"); }
.entry-page Label, .entry-menu Label { white-space: normal; }
.entry-page { flex-grow: 1; padding: 48px 72px 38px; background-color: #241f2b; }
.entry-header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 30px; flex-shrink: 0; }
.entry-title { font-size: 46px; -unity-font-definition: url("project://database/Assets/Game/UI/Fonts/AlegreyaSans-Medium.ttf"); }
.entry-steps { font-size: 20px; color: #d5a84a; }
.entry-workspace { flex-grow: 1; min-height: 0; flex-direction: row; }
.entry-roster { width: 30%; margin-right: 30px; }
.entry-character-grid { flex-direction: row; flex-wrap: wrap; }
.entry-choice { background-color: rgba(64,55,70,0.96); color: #e8d8b8; border-width: 2px; border-bottom-width: 4px; border-color: #241b2b; border-top-color: #75616a; border-bottom-color: #1d1721; border-radius: 10px; padding: 14px; margin: 0 12px 16px 0; white-space: normal; transition-property: background-color, border-color, translate, scale, opacity; transition-duration: 0.12s; transition-timing-function: ease-out; }
.entry-choice:hover { background-color: #514452; border-color: #bfaf95; translate: 0 -2px; }
.entry-choice:active { background-color: #302936; translate: 0 1px; scale: 0.99 0.99; }
.entry-choice.entry-selected { border-color: #d5a84a; border-top-color: #ead28e; border-bottom-color: #6f4727; background-color: #51423f; }
.entry-choice:focus { border-color: #e8d8b8; border-width: 3px; }
.entry-choice:disabled { color: #a99aaa; background-color: #352d3c; }
.entry-choice-name { font-size: 27px; -unity-font-definition: url("project://database/Assets/Game/UI/Fonts/AlegreyaSans-Medium.ttf"); margin-top: 8px; }
.entry-choice-state { font-size: 18px; color: #bfaf95; margin-top: 8px; }
.entry-selected .entry-choice-state { color: #d5a84a; }
.entry-character-choice { width: 46%; }
.entry-character-crop { height: 180px; width: 100%; }
.entry-page .unity-scroller { width: 12px; }
.entry-page .unity-scroller__low-button, .entry-page .unity-scroller__high-button { display: none; }
.entry-page .unity-base-slider__tracker { background-color: #241b2b; }
.entry-page .unity-base-slider__dragger { background-color: #78657b; border-radius: 5px; }
.entry-character-detail { flex-grow: 1; min-width: 0; flex-direction: row; background-color: rgba(53,45,60,0.96); border-width: 2px; border-bottom-width: 4px; border-color: #241b2b; border-top-color: #75616a; border-bottom-color: #1d1721; border-radius: 12px; overflow: hidden; }
.entry-hero-well { width: 46%; padding: 20px; background-color: #2d2633; justify-content: center; }
.entry-hero-image { flex-grow: 1; min-height: 0; }
.entry-mystery > .entry-character-copy { display: none; }
.entry-mystery > .entry-hero-well { width: 100%; }
.entry-mystery .entry-lock { -unity-text-align: middle-center; font-size: 32px; }
.entry-lock { font-size: 21px; color: #d5a84a; margin-top: 16px; flex-shrink: 0; }
.entry-character-copy { flex-grow: 1; min-width: 0; padding: 38px 28px; }
.entry-name { font-size: 56px; -unity-font-definition: url("project://database/Assets/Game/UI/Fonts/AlegreyaSans-Medium.ttf"); margin-bottom: 16px; }
.entry-role { font-size: 25px; color: #bfaf95; }
.entry-eyebrow { font-size: 17px; color: #d5a84a; margin-top: 32px; margin-bottom: 16px; }
.entry-skill { font-size: 30px; margin-bottom: 12px; }
.entry-skill-heading { flex-direction: row; align-items: center; }
.entry-skill-icon { width: 80px; height: 80px; margin-right: 16px; flex-shrink: 0; }
.entry-compact .entry-skill-icon { width: 58px; height: 58px; }
.entry-copy { font-size: 22px; }
.entry-highlights { font-size: 22px; margin-top: 28px; padding-top: 22px; margin-bottom: 24px; border-top-width: 1px; border-top-color: #68576b; }
.entry-muted { font-size: 18px; color: #bfaf95; }
.entry-footer { flex-direction: row; align-items: center; margin-top: 24px; min-height: 76px; flex-shrink: 0; }
.entry-footer-detail { flex-grow: 1; font-size: 22px; color: #bfaf95; margin: 0 28px; }
.entry-back-space { width: 190px; }
.entry-action { min-width: 190px; min-height: 68px; padding: 12px 30px; margin: 0; font-size: 26px; -unity-font-definition: url("project://database/Assets/Game/UI/Fonts/AlegreyaSans-Medium.ttf"); background-color: #403746; color: #e8d8b8; border-width: 2px; border-bottom-width: 4px; border-color: #241b2b; border-top-color: #806d78; border-bottom-color: #1d1721; border-radius: 9px; transition-property: background-color, border-color, translate, scale, opacity; transition-duration: 0.12s; transition-timing-function: ease-out; }
.entry-action.entry-primary { min-width: 280px; background-color: #a65f43; border-top-color: #d08a69; border-bottom-color: #5a2f25; }
.entry-action:hover { border-color: #d7c5a6; background-color: #55485c; translate: 0 -2px; }
.entry-action.entry-primary:hover { background-color: #b96e4f; border-top-color: #e1a07f; }
.entry-action:active { background-color: #302936; translate: 0 1px; scale: 0.99 0.99; }
.entry-action:focus { border-color: #e8d8b8; border-width: 3px; }
.entry-action:disabled { background-color: #39313f; color: #9d8e9e; border-color: #574b5d; opacity: 0.58; translate: 0 0; }
.entry-field-scroll { flex-grow: 1; min-height: 0; }
.entry-field-scroll .unity-scroll-view__content-container { flex-grow: 1; justify-content: center; }
.entry-field-grid { flex-direction: row; flex-wrap: wrap; }
.entry-field-tests { display: none; margin-top: 24px; }
.entry-field-tests-title { font-size: 20px; color: #bfaf95; margin-bottom: 12px; border-top-width: 1px; border-top-color: #68576b; padding-top: 14px; }
.entry-field-choice { width: 18.8%; }
.entry-field-image { height: 144px; width: 100%; flex-shrink: 0; }
.entry-footer-portrait { width: 58px; height: 58px; margin-right: 16px; }
.entry-field-footer-hero { flex-grow: 1; flex-direction: row; align-items: center; margin: 0 28px; }
.entry-dev-actions { display: none; flex-direction: column; max-width: 360px; }
.entry-dev-open .entry-dev-actions { display: flex; }
.entry-field-choice.entry-locked .entry-field-image { opacity: 0.45; }
.entry-field-detail { min-height: 42px; font-size: 22px; color: #bfaf95; margin-top: 14px; }
.entry-compact .entry-page, .entry-page.entry-compact { padding: 28px 36px 20px; }
.entry-compact .entry-header { margin-bottom: 20px; }
.entry-compact .entry-title { font-size: 36px; }
.entry-compact .entry-steps { font-size: 17px; }
.entry-compact .entry-roster { width: 29%; margin-right: 20px; }
.entry-compact .entry-choice { padding: 9px; margin-right: 9px; margin-bottom: 12px; }
.entry-compact .entry-character-crop { height: 116px; }
.entry-compact .entry-choice-name { font-size: 22px; }
.entry-compact .entry-choice-state { font-size: 16px; }
.entry-compact .entry-character-copy { padding: 24px 20px; }
.entry-compact .entry-name { font-size: 42px; margin-bottom: 10px; }
.entry-compact .entry-role { font-size: 20px; }
.entry-compact .entry-copy, .entry-compact .entry-highlights { font-size: 19px; }
.entry-compact .entry-highlights { padding-top: 15px; margin-top: 18px; margin-bottom: 18px; }
.entry-compact .entry-eyebrow { margin-top: 20px; margin-bottom: 10px; font-size: 15px; }
.entry-compact .entry-skill { font-size: 25px; }
.entry-compact .entry-muted { font-size: 16px; }
.entry-compact .entry-lock { font-size: 18px; }
.entry-compact .entry-action { min-width: 145px; min-height: 54px; padding: 10px 23px; font-size: 23px; }
.entry-compact .entry-primary { min-width: 235px; }
.entry-compact .entry-footer { min-height: 60px; margin-top: 16px; }
.entry-compact .entry-footer-detail { font-size: 18px; }
.entry-compact .entry-field-image { height: 100px; }
.entry-compact .entry-field-choice .entry-choice-name { font-size: 20px; margin-top: 5px; }
.entry-compact .entry-field-choice .entry-choice-state { font-size: 14px; margin-top: 4px; }
.entry-compact .entry-field-detail { min-height: 28px; font-size: 18px; }
.entry-menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; background-color: #241b2b; justify-content: center; }
.entry-menu-controls { width: 440px; margin-left: 114px; }
.entry-menu-title { font-size: 68px; -unity-font-definition: url("project://database/Assets/Game/UI/Fonts/AlegreyaSans-Medium.ttf"); margin-bottom: 56px; }
.entry-menu-controls .entry-action { margin-bottom: 14px; -unity-text-align: middle-left; }
.entry-menu-controls .entry-primary { margin-bottom: 28px; }
.entry-menu-controls .entry-quiet { background-color: rgba(48,41,54,0.5); margin-top: 20px; }
.entry-compact .entry-menu-controls { width: 350px; margin-left: 76px; }
.entry-compact .entry-menu-title { font-size: 50px; margin-bottom: 35px; }
.entry-art, .entry-art-layer { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.entry-art { overflow: hidden; }
.entry-art-back { scale: 1.05 1.05; }
.entry-art-front { width: 90%; height: 90%; left: 7.5%; top: 10%; right: auto; bottom: auto; }
.entry-root .shell-back { left: 72px; top: auto; bottom: 38px; width: 190px; height: 68px; }
.entry-compact .shell-back { left: 36px; bottom: 20px; width: 145px; height: 54px; }
