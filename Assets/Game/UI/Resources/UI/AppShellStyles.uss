.shell-page { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgb(12, 17, 26); color: rgb(233, 237, 244); }
.shell-panel { width: 620px; max-height: 94%; padding: 28px; background-color: rgb(26, 34, 48); border-radius: 12px; }
.settings-panel { width: 900px; }
.shell-title { font-size: 34px; -unity-font-style: bold; margin-bottom: 24px; }
.shell-panel Button { min-height: 46px; margin-top: 8px; font-size: 20px; }
.shell-panel Label { white-space: normal; }
.shell-panel Slider, .shell-panel Toggle, .shell-panel DropdownField { margin-top: 16px; font-size: 18px; }
.shell-row { flex-direction: row; margin-top: 12px; }
.shell-row Button { flex-grow: 1; }
.shell-back { position: absolute; left: 30px; top: 25px; width: 180px; height: 44px; }
.shell-pause { position: absolute; bottom: 35px; align-self: center; flex-direction: row; }
.shell-pause Button { width: 180px; height: 44px; }
.shell-dev-row { position: absolute; left: 20px; bottom: 20px; flex-direction: row; }
.shell-dev { margin-right: 8px; height: 34px; padding: 0 12px; font-size: 14px; background-color: rgb(58, 40, 22); color: rgb(255, 214, 150); border-color: rgb(150, 110, 60); border-width: 1px; border-radius: 5px; opacity: 0.85; }
.shell-dev:hover { opacity: 1; background-color: rgb(80, 56, 30); }
.shell-dev-danger { background-color: rgb(78, 28, 24); color: rgb(255, 190, 180); border-color: rgb(170, 70, 60); }
.shell-dev-danger:hover { background-color: rgb(110, 36, 30); }
.shell-message { color: rgb(255, 210, 130); margin-top: 16px; }

.shell-panel Button, .shell-back, .shell-pause Button { background-color: rgb(45, 61, 83); color: rgb(242, 246, 251); border-color: rgb(91, 120, 153); border-width: 1px; border-radius: 5px; }
.shell-panel Button:hover, .shell-back:hover, .shell-pause Button:hover { background-color: rgb(64, 86, 117); }
.shell-panel Button:active, .shell-back:active, .shell-pause Button:active { background-color: rgb(31, 45, 64); }
.shell-panel Button:disabled { background-color: rgb(37, 43, 54); color: rgb(135, 145, 158); }
.settings-panel .unity-base-text-field__input { color: rgb(20, 25, 32); background-color: rgb(230, 235, 241); min-width: 65px; }
.settings-panel .unity-base-popup-field__input { color: rgb(20, 25, 32); background-color: rgb(230, 235, 241); }
/* DECISION-0107: one notification toast in the folio palette; kind line + subject line. */
.shell-notification { position: absolute; top: 20px; right: 25px; min-width: 260px; max-width: 460px; padding: 10px 18px 12px 16px; background-color: rgba(48, 41, 54, 0.94); border-width: 2px; border-left-width: 5px; border-color: #645263; border-left-color: #D5A84A; border-radius: 10px; -unity-font-definition: url("project://database/Assets/Game/UI/Fonts/PTSans-Regular.ttf"); }
.shell-notification-title { font-size: 15px; color: #D5A84A; letter-spacing: 1px; margin: 0; padding: 0; white-space: normal; }
.shell-notification-detail { font-size: 22px; color: #E8D8B8; margin: 2px 0 0 0; padding: 0; white-space: normal; -unity-font-definition: url("project://database/Assets/Game/UI/Fonts/AlegreyaSans-Medium.ttf"); }
.shell-notification-detail.shell-empty { display: none; }
