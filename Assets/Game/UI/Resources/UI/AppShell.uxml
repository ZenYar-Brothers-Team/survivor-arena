<ui:UXML xmlns:ui="UnityEngine.UIElements">
  <ui:VisualElement name="ShellMenu" class="entry-menu"><ui:VisualElement class="entry-menu-controls">
    <ui:Label text="SURVIVOR&#10;ARENA" class="entry-menu-title" />
    <ui:Button name="ShellPlay" text="Играть" class="entry-action entry-primary" /><ui:Button name="ShellMeta" text="Развитие" class="entry-action" /><ui:Button name="ShellSettings" text="Настройки" class="entry-action" /><ui:Button name="ShellExit" text="Выйти" class="entry-action entry-quiet" />
  </ui:VisualElement></ui:VisualElement>
  <ui:VisualElement name="ShellDevelopment" class="shell-dev-row" picking-mode="Ignore">
    <ui:Button name="EntryDevelopmentToggle" text="DEV" class="shell-dev" />
    <ui:VisualElement class="entry-dev-actions">
    <ui:Button name="ShellDevelopmentUnlockAll" text="DEV: unlock all characters &amp; fields" class="shell-dev" />
    <ui:Button name="ShellDevelopmentGrantCurrency" text="DEV: +100 000 coins" class="shell-dev" />
    <ui:Button name="ShellDevelopmentReset" text="DEV: reset all progression" class="shell-dev shell-dev-danger" />
    </ui:VisualElement>
  </ui:VisualElement>
  <ui:Button name="ShellBack" text="← Назад" class="shell-back entry-action" />
  <ui:VisualElement name="ShellPause" class="shell-pause"><ui:Button name="ShellPauseSettings" text="Settings" /><ui:Button name="ShellQuit" text="Quit Run" /></ui:VisualElement>
  <ui:VisualElement name="SettingsBody" class="settings-page"><ui:VisualElement class="settings-folio">
    <ui:VisualElement name="SettingsHeader" class="settings-header"><ui:Label text="Настройки" class="settings-title" /><ui:Label name="SettingsOrigin" class="settings-muted" /></ui:VisualElement>
    <ui:ScrollView name="SettingsScroll" class="settings-scroll" horizontal-scroller-visibility="Hidden">
      <ui:VisualElement name="SettingsContent" class="settings-columns">
        <ui:VisualElement class="settings-column settings-audio">
          <ui:Label text="Звук" class="settings-heading" />
          <ui:VisualElement class="settings-volume"><ui:VisualElement class="settings-volume-label"><ui:Label text="Общая громкость" /><ui:Label name="SettingsMasterValue" class="settings-percent" /></ui:VisualElement><ui:Slider name="SettingsMaster" tooltip="Общая громкость" low-value="0" high-value="100" /></ui:VisualElement>
          <ui:VisualElement class="settings-volume"><ui:VisualElement class="settings-volume-label"><ui:Label text="Музыка" /><ui:Label name="SettingsMusicValue" class="settings-percent" /></ui:VisualElement><ui:Slider name="SettingsMusic" tooltip="Музыка" low-value="0" high-value="100" /></ui:VisualElement>
          <ui:VisualElement class="settings-volume"><ui:VisualElement class="settings-volume-label"><ui:Label text="Звуки" /><ui:Label name="SettingsSfxValue" class="settings-percent" /></ui:VisualElement><ui:Slider name="SettingsSfx" tooltip="Звуки" low-value="0" high-value="100" /></ui:VisualElement>
          <ui:VisualElement class="settings-actions"><ui:Button name="SettingsMusicPreview" text="Проверить музыку" /><ui:Button name="SettingsSfxPreview" text="Проверить звуки" /></ui:VisualElement>
          <ui:Label text="Громкость применяется сразу." class="settings-hint" />
        </ui:VisualElement>
        <ui:VisualElement class="settings-column settings-right">
          <ui:Label text="Изображение" class="settings-heading" />
          <ui:DropdownField name="SettingsWindow" label="Режим" class="settings-select" />
          <ui:DropdownField name="SettingsResolution" label="Разрешение" class="settings-select" />
          <ui:DropdownField name="SettingsUiScale" label="Масштаб интерфейса" class="settings-select" />
          <ui:VisualElement class="settings-video-actions"><ui:Button name="SettingsApply" text="Применить" /><ui:Label name="SettingsVideoStatus" class="settings-muted" /></ui:VisualElement>
          <ui:VisualElement class="settings-gameplay"><ui:Label text="Управление" class="settings-heading" />
            <ui:Toggle name="SettingsMouseMovement" label="Управление мышью" />
            <ui:Toggle name="SettingsShake" label="Дрожание камеры" />
            <ui:Label name="SettingsBindings" class="settings-hint" />
            <ui:Label text="Пауза    Esc · Пробел · ПКМ" class="settings-hint" />
          </ui:VisualElement>
        </ui:VisualElement>
      </ui:VisualElement>
    </ui:ScrollView>
    <ui:VisualElement name="SettingsFooter" class="settings-footer"><ui:Button name="SettingsBack" text="Назад" /><ui:Label name="SettingsMessage" class="settings-muted" /><ui:Button name="SettingsSave" text="Повторить сохранение" /></ui:VisualElement>
    <ui:VisualElement name="SettingsModal" class="settings-modal settings-hidden"><ui:VisualElement class="settings-dialog"><ui:Label text="Оставить этот режим?" class="settings-heading" /><ui:Label name="SettingsConfirmStatus" /><ui:VisualElement class="settings-actions"><ui:Button name="SettingsRevert" text="Вернуть" /><ui:Button name="SettingsKeep" text="Оставить" class="settings-primary" /></ui:VisualElement></ui:VisualElement></ui:VisualElement>
  </ui:VisualElement></ui:VisualElement>
<ui:VisualElement name="ShellNotification" class="shell-notification" picking-mode="Ignore"><ui:Label name="ShellNotificationTitle" class="shell-notification-title" picking-mode="Ignore" /><ui:Label name="ShellNotificationDetail" class="shell-notification-detail" picking-mode="Ignore" /></ui:VisualElement>
</ui:UXML>
