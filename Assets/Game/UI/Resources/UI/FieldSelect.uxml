<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="entry-page">
        <ui:VisualElement class="entry-header">
            <ui:Label text="Выбери поле" class="entry-title" />
            <ui:Label text="1 · Персонаж    —    2 · Поле" class="entry-steps" />
        </ui:VisualElement>
        <ui:ScrollView class="entry-field-scroll">
            <ui:VisualElement name="field-select-cards" class="entry-field-grid" />
        </ui:ScrollView>
        <ui:Label name="entry-field-detail" class="entry-field-detail" />
        <ui:VisualElement class="entry-footer">
            <ui:Button name="field-select-back" text="← Назад" class="entry-action" />
            <ui:VisualElement name="entry-field-hero" class="entry-field-footer-hero" />
            <ui:Button name="field-select-start" text="Начать забег" class="entry-action entry-primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
